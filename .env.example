# Desarrollo local: development. Servidor: production
NODE_ENV=development
PORT=3000

# MySQL/MariaDB. En Windows puede apuntar al túnel SSH (ej. puerto 3311).
DATABASE_URL=mysql://antonini:CAMBIA_ESTA_CLAVE@127.0.0.1:3311/antonini

# Sesión del panel admin (mínimo 32 caracteres; recomendado 64+)
JWT_SECRET=CAMBIA_ESTO_POR_UN_SECRETO_LARGO_Y_ALEATORIO
VITE_APP_ID=antonini-self-hosted

# Almacenamiento local. Windows: ./storage. VPS recomendado: /var/lib/antonini/storage
STORAGE_DIR=./storage

# Administrador (usado solo por pnpm init-admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CAMBIA_ESTA_CLAVE_POR_UNA_DE_12_O_MAS_CARACTERES
ADMIN_EMAIL=admin@tudominio.com
ADMIN_NAME=Administrador

# Telegram (opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
